# =============================================================================
# Конфигурация сборки Halium -> Droidian для Xiaomi POCO F4 / Redmi K40S (munch)
# Все переменные можно переопределить из окружения:
#   KERNEL_REPO=... ./build.sh all
# =============================================================================

# --- Исходники ядра ---------------------------------------------------------
# Официальный дамп Xiaomi (Android 12, ядро 4.19.157, defconfig проверен).
# Альтернатива (лучше поддерживается, но потребует поменять KERNEL_DEFCONFIG):
#   https://github.com/xiaomi-sm8250-devs/android_kernel_xiaomi_sm8250
KERNEL_REPO="${KERNEL_REPO:-https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git}"
KERNEL_BRANCH="${KERNEL_BRANCH:-munch-s-oss}"
KERNEL_DEFCONFIG="${KERNEL_DEFCONFIG:-munch_user_defconfig}"

# Общие kconfig-фрагменты Droidian (halium.config, droidian.config, debug.config).
# Ветка должна соответствовать версии ядра: для munch это 4.19.
FRAGMENTS_REPO="${FRAGMENTS_REPO:-https://github.com/droidian-devices/common_fragments.git}"
FRAGMENTS_BRANCH="${FRAGMENTS_BRANCH:-4.19-android}"

# --- Контейнер сборки Droidian ----------------------------------------------
BUILD_IMAGE="${BUILD_IMAGE:-quay.io/droidian/build-essential:current-amd64}"
# docker или podman; пусто = автоопределение
CONTAINER_ENGINE="${CONTAINER_ENGINE:-}"

# --- Готовый rootfs Droidian -------------------------------------------------
# munch поставляется с Android 12 => halium-база api32
# (правило: api28 = Android 9, api29 = A10, api30 = A11, api32 = A12/12.1)
DROIDIAN_RELEASE_TAG="${DROIDIAN_RELEASE_TAG:-droidian/101.20251130}"
DROIDIAN_ROOTFS_ZIP="${DROIDIAN_ROOTFS_ZIP:-droidian-OFFICIAL-phosh-phone-rootfs-api32-arm64-101.20251130_20251207.zip}"
DROIDIAN_DEVTOOLS_ZIP="${DROIDIAN_DEVTOOLS_ZIP:-droidian-devtools-api32-arm64_20251207.zip}"
DROIDIAN_DOWNLOAD_BASE="${DROIDIAN_DOWNLOAD_BASE:-https://github.com/droidian-images/droidian/releases/download}"

# --- Каталоги (относительно корня репозитория) --------------------------------
WORK_DIR="${WORK_DIR:-$ROOT_DIR/work}"
KERNEL_DIR="${KERNEL_DIR:-$WORK_DIR/kernel}"
PACKAGES_DIR="${PACKAGES_DIR:-$WORK_DIR/packages}"
OUT_DIR="${OUT_DIR:-$ROOT_DIR/out}"
