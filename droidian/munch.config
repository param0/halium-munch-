# =============================================================================
# Девайс-фрагмент kconfig для Xiaomi POCO F4 (munch)
#
# Общие требования Halium/Droidian приезжают из droidian/common_fragments
# (ветка 4.19-android: halium.config, droidian.config, debug.config) —
# здесь только то, чего там нет, и специфичное для munch.
# =============================================================================

CONFIG_LOCALVERSION="-munch"

# --- LVM-rootfs Droidian (droidian.lvm.prefer) требует device-mapper ---------
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y

# --- systemd ------------------------------------------------------------------
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Файловые системы rootfs ---------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- EROFS: свежие MIUI держат system/vendor в EROFS -----------------------------
# Без этого драйвера initramfs не может смонтировать /vendor
# (в дереве munch-s-oss erofs живёт в drivers/staging/erofs)
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# --- Распаковка initramfs -------------------------------------------------------
# Загрузчик (header v3) склеивает ramdisk из стокового vendor_boot с нашим:
# ядро обязано уметь распаковать ОБА сегмента. Наш — gzip (RD_GZIP из
# common_fragments), стоковый может быть lz4 — включаем на всякий случай.
CONFIG_RD_LZ4=y

# --- Возможные точки итерации (добавить при проблемах) ------------------------
# Если вендорные/пересобранные модули (например wlan) не грузятся из-за подписи,
# добавьте строки:  CONFIG_MODULE_SIG=n  и  CONFIG_MODULE_SIG_FORCE=n
# Если initramfs не находит консоль / нет вывода, добавьте:  CONFIG_FB=y
