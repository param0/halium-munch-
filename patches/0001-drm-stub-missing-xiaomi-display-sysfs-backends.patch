diff --git a/drivers/gpu/drm/drm_sysfs_mi_stub.c b/drivers/gpu/drm/drm_sysfs_mi_stub.c
new file mode 100644
index 00000000..f4d53efc
--- /dev/null
+++ b/drivers/gpu/drm/drm_sysfs_mi_stub.c
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Xiaomi's public munch-s-oss source drop ships drm_sysfs.c with MIUI
+ * display sysfs nodes but omits their backend (dsi_display_mi.c is not
+ * published), which breaks the vmlinux link. Provide inert stubs so the
+ * MIUI-specific nodes return -ENODEV; nothing outside MIUI uses them.
+ */
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+
+struct drm_connector;
+
+int dsi_display_set_disp_param(struct drm_connector *connector,
+			       u32 param_type)
+{
+	return -ENODEV;
+}
+
+int dsi_display_get_disp_param(struct drm_connector *connector,
+			       u32 *param_type)
+{
+	if (param_type)
+		*param_type = 0;
+	return -ENODEV;
+}
+
+ssize_t dsi_display_write_mipi_reg(struct drm_connector *connector, char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_read_mipi_reg(struct drm_connector *connector, char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_read_oled_pmic_id(struct drm_connector *connector,
+				      char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_read_panel_info(struct drm_connector *connector, char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_read_wp_info(struct drm_connector *connector, char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_read_dynamic_fps(struct drm_connector *connector,
+				     char *buf)
+{
+	return -ENODEV;
+}
+
+int dsi_display_set_doze_brightness(struct drm_connector *connector,
+				    int doze_brightness)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_get_doze_brightness(struct drm_connector *connector,
+					char *buf)
+{
+	return -ENODEV;
+}
+
+int dsi_display_read_gamma_param(struct drm_connector *connector)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_print_gamma_param(struct drm_connector *connector,
+				      char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t dsi_display_fod_get(struct drm_connector *connector, char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t complete_commit_time_get(struct drm_connector *connector, char *buf)
+{
+	return -ENODEV;
+}
+
+int dsi_display_set_thermal_hbm_disabled(struct drm_connector *connector,
+					 bool thermal_hbm_disabled)
+{
+	return -ENODEV;
+}
+
+int dsi_display_get_thermal_hbm_disabled(struct drm_connector *connector,
+					 bool *thermal_hbm_disabled)
+{
+	if (thermal_hbm_disabled)
+		*thermal_hbm_disabled = false;
+	return -ENODEV;
+}
+
+ssize_t dsi_display_get_hw_vsync_info(struct drm_connector *connector,
+				      char *buf)
+{
+	return -ENODEV;
+}
+
+ssize_t smart_fps_value_show(struct device *device,
+			     struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "0\n");
+}
