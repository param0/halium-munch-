########################################################################
# Kernel settings — Xiaomi POCO F4 / Redmi K40S (munch), SM8250-AC/SD870
# Шаблон: плейсхолдеры @...@ заполняются скриптом build.sh (стадия setup)
########################################################################

# Downstream (android) ядро
VARIANT = android

# Базовая версия ядра (автоопределяется из Makefile ядра)
KERNEL_BASE_VERSION = @KERNEL_BASE_VERSION@

# Командная строка ядра.
# База — стоковый cmdline платформы kona (sm8250) + добавки Droidian:
#   androidboot.selinux=permissive — SELinux в permissive
#   buildvariant=userdebug
#   droidian.lvm.prefer            — предпочитать LVM-rootfs Droidian
# Сверьте со стоковым boot.img своего устройства:
#   unpackbootimg --boot_img boot.img  (или unpack_bootimg из AOSP)
KERNEL_BOOTIMAGE_CMDLINE = console=ttyMSM0,115200n8 androidboot.hardware=qcom androidboot.console=ttyMSM0 androidboot.memcg=1 lpm_levels.sleep_disabled=1 video=vfb:640x400,bpp=32,memsize=3072000 msm_rtb.filter=0x237 service_locator.enable=1 androidboot.usbcontroller=a600000.dwc3 swiotlb=0 loop.max_part=7 cgroup.memory=nokmem,nosocket pcie_ports=compat iptable_raw.raw_before_defrag=1 ip6table_raw.raw_before_defrag=1 androidboot.selinux=permissive buildvariant=userdebug droidian.lvm.prefer

DEVICE_VENDOR = xiaomi
DEVICE_MODEL = munch
DEVICE_FULL_NAME = Xiaomi POCO F4

# Используем kconfig-фрагменты из каталога droidian/ в корне исходников ядра
KERNEL_CONFIG_USE_FRAGMENTS = 1
KERNEL_CONFIG_USE_DIFFCONFIG = 0

# Defconfig (автозаполняется из config.env)
KERNEL_DEFCONFIG = @KERNEL_DEFCONFIG@

# munch — устройство с boot header v3: DTB грузится загрузчиком из
# СТОКОВОГО vendor_boot, dtbo — из стокового раздела dtbo.
# Поэтому в boot.img кладём только ядро + initramfs Droidian.
KERNEL_IMAGE_WITH_DTB = 0
KERNEL_IMAGE_WITH_DTB_OVERLAY = 0
KERNEL_IMAGE_WITH_DTB_OVERLAY_IN_KERNEL = 0

# Параметры mkbootimg. Для header v3 смещения игнорируются,
# значимы только page size, cmdline и patch level.
KERNEL_BOOTIMAGE_PAGE_SIZE = 4096
KERNEL_BOOTIMAGE_BASE_OFFSET = 0x00000000
KERNEL_BOOTIMAGE_KERNEL_OFFSET = 0x00008000
KERNEL_BOOTIMAGE_INITRAMFS_OFFSET = 0x01000000
KERNEL_BOOTIMAGE_SECONDIMAGE_OFFSET = 0x00f00000
KERNEL_BOOTIMAGE_TAGS_OFFSET = 0x00000100

# Security patch level: должен быть НЕ НИЖЕ уровня заплаток прошитой MIUI,
# иначе Android Verified Boot / anti-rollback может отказать в загрузке.
KERNEL_BOOTIMAGE_PATCH_LEVEL = 2025-12

# munch поставлялся с Android 12 => boot header version 3
KERNEL_BOOTIMAGE_VERSION = 3

########################################################################
# Android verified boot
########################################################################

# Собирать пустой vbmeta.img (отключает verified boot)
DEVICE_VBMETA_REQUIRED = 1
DEVICE_VBMETA_IS_SAMSUNG = 0

########################################################################
# Автоматическая прошивка при обновлении пакета (уже из Droidian)
########################################################################

FLASH_ENABLED = 1
FLASH_IS_AONLY = 0
FLASH_IS_LEGACY_DEVICE = 0
FLASH_IS_EXYNOS = 0

# Должно совпадать с ro.product.vendor.manufacturer / ro.product.vendor.model
FLASH_INFO_MANUFACTURER = Xiaomi
FLASH_INFO_MODEL = munch
FLASH_INFO_CPU = Qualcomm Technologies, Inc SM8250
FLASH_INFO_DEVICE_IDS = munch

########################################################################
# Kernel build settings
########################################################################

BUILD_CROSS = 1
BUILD_TRIPLET = aarch64-linux-android-
BUILD_CLANG_TRIPLET = aarch64-linux-gnu-
BUILD_CC = clang

# Стоковое ядро munch (A12, msm-4.19) собирается clang r416183b (clang 12).
# Если сборка спотыкается — попробуйте 10.0-r370808 (использовался для A11).
CLANG_VERSION = 12.0-r416183b
BUILD_PATH = /usr/lib/llvm-android-$(CLANG_VERSION)/bin

# clang-android-$(CLANG_VERSION) сюда добавлять не нужно —
# kernel-snippet.mk добавляет его сам на основе CLANG_VERSION.
DEB_TOOLCHAIN = device-tree-compiler, linux-initramfs-halium-generic:arm64, binutils-aarch64-linux-gnu, gcc-4.9-aarch64-linux-android, g++-4.9-aarch64-linux-android, libgcc-4.9-dev-aarch64-linux-android-cross

DEB_BUILD_ON = amd64
DEB_BUILD_FOR = arm64

KERNEL_ARCH = arm64
# ВАЖНО: сырое несжатое Image, как у стока/LineageOS для sm8250.
# ARM64-ядро само себя не распаковывает, а ABL munch не разворачивает
# gzip — с Image.gz устройство не подаёт признаков жизни вообще.
KERNEL_BUILD_TARGET = Image
